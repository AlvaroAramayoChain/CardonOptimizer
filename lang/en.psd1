# CardonOptimizer - English
# To translate: copy this file as <code>.psd1 (for example pt.psd1) and translate the values.
# Do not change the keys. Placeholders {0}, {1}... must be kept.
@{
    # --- Language -------------------------------------------------------------
    LanguageName   = 'English'
    LanguagePrompt = 'Choose your language'
    SortOrder      = 2
    YesKey         = 'Y'
    NoKey          = 'N'

    # --- Welcome and menu -----------------------------------------------------
    Welcome_Tagline = 'Optimizes and lightens Windows 10/11 in a simple and safe way.'
    Welcome_Safety  = 'A restore point and a backup are created before every change. Nothing is applied without your confirmation.'
    Info_System     = 'Detected system: {0} (build {1})'
    Menu_Title      = '=== Main menu ==='
    Menu_1          = 'Standard optimization'
    Menu_2          = 'Advanced optimization'
    Menu_3          = 'Extreme optimization (safe)'
    Menu_4          = 'Preview (shows what a level would do, without applying anything)'
    Menu_5          = 'Undo changes / restore'
    Menu_6          = 'View log'
    Menu_7          = 'Change language'
    Menu_0          = 'Exit'
    Menu_Back       = 'Back'
    Prompt_Choice   = 'Choose an option'
    Prompt_PressEnter = 'Press Enter to continue'
    Err_MenuOption  = 'Invalid option.'
    Info_Goodbye    = 'Thank you for using CardonOptimizer!'

    # --- Elevation and system -------------------------------------------------
    Elevation_Requesting = 'Administrator rights are required. A new window will open (accept the Windows prompt).'
    Elevation_Failed     = 'Administrator rights were not granted. Right-click Ejecutar.bat and choose "Run as administrator".'
    Err_NotAdmin         = 'This action requires administrator rights.'
    Err_UnsupportedOs    = 'Unsupported system: {0}. CardonOptimizer only works on Windows 10 and Windows 11 (not on Windows Server).'

    # --- Levels ---------------------------------------------------------------
    Level_1_Title   = 'Standard optimization'
    Level_1_Summary = 'Very safe. Frees disk space, removes system ads and selects a faster power plan.'
    Level_2_Title   = 'Advanced optimization'
    Level_2_Summary = 'Includes Standard. Tunes visual effects, startup programs (you choose), telemetry, widgets and disk maintenance.'
    Level_3_Title   = 'Extreme optimization (safe)'
    Level_3_Summary = 'Includes Advanced. Lets you remove preinstalled apps (you choose), sets a few unneeded services to Manual and removes animations.'
    Ask_ApplyLevel  = 'Apply "{0}" now?'
    Info_Cancelled  = 'Operation cancelled. No changes were applied.'
    Info_SafetyNet  = 'Before starting, a restore point and a backup of everything that changes will be created.'
    Warn_Level2_Time = 'Note: component cleanup (DISM) and disk optimization may take several minutes.'
    Warn_Level3_Apps = 'IMPORTANT: removing apps can NOT be undone. "Undo" restores registry, services, power plan and startup tasks, but NOT removed apps: they must be reinstalled from Microsoft Store. No app is preselected.'
    Info_StoreReinstall = 'To reinstall a removed app: open Microsoft Store, search for it by name and click "Get" (or use: winget install "<name>").'

    # --- Actions: name and description ----------------------------------------
    Action_TempFiles_Name = 'Cleaning temporary files'
    Action_TempFiles_Desc = 'Deletes user and Windows temporary files older than 24 hours. Files in use are skipped.'
    Action_ThumbnailCache_Name = 'Cleaning thumbnail cache'
    Action_ThumbnailCache_Desc = 'Deletes the File Explorer thumbnail cache. Windows rebuilds it automatically.'
    Action_UpdateCache_Name = 'Cleaning Windows Update cache'
    Action_UpdateCache_Desc = 'Deletes already downloaded updates. Stops the service briefly and starts it again. No Windows Update setting is changed.'
    Action_CrashDumps_Name = 'Cleaning old crash dumps'
    Action_CrashDumps_Desc = 'Deletes error reports (memory dumps) older than 7 days.'
    Action_RecycleBin_Name = 'Emptying the Recycle Bin'
    Action_RecycleBin_Desc = 'Empties the Recycle Bin. Check it first if you kept something there.'
    Action_DnsCache_Name = 'Flushing DNS cache'
    Action_DnsCache_Desc = 'Runs ipconfig /flushdns. Harmless: fixes pages that do not load.'
    Action_PowerPlan_Name = 'Setting the power plan'
    Action_PowerPlan_Desc = 'Desktop: activates "High performance" (or "Balanced" if it does not exist). Notebook: keeps "Balanced". Reversible.'
    Action_GameDvr_Name = 'Disabling background recording (Game DVR)'
    Action_GameDvr_Desc = 'Stops Xbox Game Bar from recording games in the background. The Game Bar is still available.'
    Action_Suggestions_Name = 'Disabling suggestions and ads'
    Action_Suggestions_Desc = 'Removes promoted apps, Start menu suggestions and suggested content in Settings.'
    Action_VisualEffects_Name = 'Tuning visual effects'
    Action_VisualEffects_Desc = 'Removes taskbar and list animations and shadows. Keeps font smoothing and thumbnails.'
    Action_StartupApps_Name = 'Reviewing startup programs'
    Action_StartupApps_Desc = 'Shows programs that start with Windows and you choose which ones to disable. Antivirus and drivers are not shown.'
    Action_BackgroundApps_Name = 'Limiting background apps'
    Action_BackgroundApps_Desc = 'Stops Store apps from running in the background (your user only). Some may stop showing notifications.'
    Action_Widgets_Name = 'Disabling widgets and news'
    Action_Widgets_Desc = 'Removes Widgets (Windows 11) or News and interests (Windows 10) from the taskbar.'
    Action_Telemetry_Name = 'Reducing telemetry'
    Action_Telemetry_Desc = 'Lowers diagnostic data to the minimum your Windows edition allows. No services are disabled.'
    Action_ComponentCleanup_Name = 'Cleaning Windows components (DISM)'
    Action_ComponentCleanup_Desc = 'Removes old versions of superseded components. Does not use /ResetBase: updates can still be uninstalled.'
    Action_DiskOptimization_Name = 'Optimizing drives'
    Action_DiskOptimization_Desc = 'TRIM on SSD drives and defragmentation on HDD drives. Never defragments an SSD.'
    Action_Bloatware_Name = 'Removing preinstalled apps'
    Action_Bloatware_Desc = 'Shows preinstalled apps from a safe list and removes only the ones you choose. Store, Edge, Calculator, Photos, etc. are never touched.'
    Action_ServicesManual_Name = 'Setting unneeded services to Manual'
    Action_ServicesManual_Desc = 'Fax, Maps, retail demo and Xbox services go from Automatic to Manual (they still start if something needs them). Never disabled.'
    Action_Animations_Name = 'Disabling animations and transparency'
    Action_Animations_Desc = 'Removes the minimize/maximize window animation and the transparency effect.'
    Action_DeliveryOptimization_Name = 'Disabling peer-to-peer update downloads'
    Action_DeliveryOptimization_Desc = 'Updates are downloaded only from Microsoft, without sharing them with other computers.'
    Action_UltimatePerformance_Name = '"Ultimate Performance" plan (optional)'
    Action_UltimatePerformance_Desc = 'Desktops only: offers to activate the Ultimate Performance plan (you are asked first). Skipped on notebooks.'

    # --- Step statuses --------------------------------------------------------
    Status_Ok        = 'OK'
    Status_Unchanged = 'Skipped (already applied)'
    Status_Skipped   = 'Skipped'
    Status_Preview   = 'Would apply'
    Status_Error     = 'Error'

    # --- Details --------------------------------------------------------------
    Detail_Files            = '{0} file(s)'
    Detail_Items            = '{0} item(s)'
    Detail_UpdateInProgress = 'Windows is installing updates; skipped so they are not interrupted.'
    Detail_ServiceMissing   = 'Service {0} does not exist on this computer; skipped.'
    Detail_DismWait         = 'This may take several minutes. Do not close the window.'
    Detail_Trim             = 'Drive {0}: SSD -> TRIM'
    Detail_Defrag           = 'Drive {0}: HDD -> defragment (may take a while)'
    Detail_DiskUnknown      = 'Drive {0}: unknown disk type; skipped for safety.'
    Warn_BatteryHighPerformance = 'A battery was detected: the "High performance" plan may increase power usage. If this is a notebook, change the device type with option 8.'
    Warn_UltimateDesktopOnly = 'The "Ultimate Performance" plan is recommended for desktop computers only: it increases power usage.'
    Warn_UltimateBattery    = 'This computer has a battery. Answering N is recommended.'
    Ask_Ultimate            = 'Activate the "Ultimate Performance" plan?'
    Ultimate_Name           = 'Ultimate Performance'

    # --- Startup programs -----------------------------------------------------
    Source_RegistryUser    = 'Registry (user)'
    Source_RegistryMachine = 'Registry (computer)'
    Source_FolderUser      = 'Startup folder (user)'
    Source_FolderMachine   = 'Startup folder (all users)'
    Source_Task            = 'Scheduled task'
    Startup_ProtectedHidden = '{0} protected item(s) hidden (antivirus, audio, video, touchpad).'
    Startup_None           = 'There are no startup programs to review.'
    Startup_PreviewNote    = 'in real mode you will choose which ones to disable'
    Ask_SelectStartup      = 'Numbers to disable (e.g. 1,3,5-7). Enter = none, 0 = cancel this list'

    # --- Preinstalled apps ----------------------------------------------------
    Warn_BloatwareIrreversible = 'Removing an app can not be undone from the backup (reinstall it from Microsoft Store).'
    Bloat_None          = 'No apps from the list are installed.'
    Bloat_PreviewNote   = 'in real mode you will choose which ones to remove'
    Bloat_Removed       = '    Removed: {0}'
    Bloat_Failed        = '    Could not remove {0}: {1}'
    Ask_SelectBloatware = 'Numbers to remove (e.g. 1,3,5-7). Enter = none, 0 = cancel this list'

    # --- Preview --------------------------------------------------------------
    Preview_Header      = 'PREVIEW MODE: no changes will be applied.'
    Preview_NotSet      = '(not set)'
    Preview_Registry    = '      {0} \ {1}: {2} -> {3}'
    Preview_Service     = '      Service {0}: {1} -> Manual'
    Preview_PowerScheme = '      Power plan: {0} -> {1}'
    Preview_Task        = '      Task {0} -> disabled'
    StartType_Automatic = 'Automatic'

    # --- Restore point --------------------------------------------------------
    RP_Creating          = 'Creating a restore point...'
    RP_Created           = 'Restore point created.'
    RP_Recent            = 'A recent restore point already exists ({0}). Windows only allows one every 24 hours.'
    RP_Failed            = 'Could not create the restore point: {0}'
    RP_ProtectionEnabled = 'System protection enabled.'
    RP_NotCreated        = 'No new restore point was created. The CardonOptimizer backup will still be created.'
    Ask_ContinueRecentRP  = 'Continue using that restore point?'
    Ask_EnableProtection  = 'System protection may be turned off. Turn it on for the system drive?'
    Ask_ContinueWithoutRP = 'Continue without a new restore point?'

    # --- Summary --------------------------------------------------------------
    Summary_Title        = '=== Summary ==='
    Summary_Freed        = 'Space freed: {0}'
    Summary_Applied      = 'Changes applied: {0}'
    Summary_Skipped      = 'Skipped: {0}'
    Summary_Errors       = 'Errors: {0}'
    Summary_Log          = 'Log: {0}'
    Summary_Backup       = 'Backup: {0}'
    Summary_Restart      = 'Restarting the computer is recommended so all changes take effect.'
    Summary_PreviewNote  = 'This was only a preview: nothing was changed.'
    Summary_PreviewCount = 'Steps that would make changes: {0}'
    Summary_PreviewSpace = 'Space that would be freed (approx.): {0}'

    # --- Undo -----------------------------------------------------------------
    Undo_Title           = '=== Undo changes ==='
    Undo_None            = 'There are no backups with changes to restore.'
    Undo_AlreadyRestored = '[already restored]'
    Undo_AppsNote        = 'Registry, services, power plan, startup programs and tasks are restored. Removed apps are reinstalled from Microsoft Store.'
    Undo_Prompt          = 'Backup number to restore (0 = back)'
    Ask_Restore          = 'Restore the backup from {0}?'
    Restore_EntryOk      = '  Restored: {0}'
    Restore_EntryFailed  = '  Could not restore {0}: {1}'
    Undo_Done            = 'Restore finished. Succeeded: {0}. Failed: {1}.'

    # --- Log ------------------------------------------------------------------
    Log_Title   = '=== Log ==='
    Log_None    = 'There are no logs yet.'
    Log_Folder  = 'Log folder: {0}'
    Log_Showing = 'Last lines of {0}:'

    # --- Errors ---------------------------------------------------------------
    Err_Generic           = 'Error: {0}'
    Err_YesNo             = 'Answer {0} or {1}.'
    Err_Selection         = 'Invalid input. Use numbers from 1 to {0}, separated by commas (e.g. 1,3,5-7).'
    Err_NoBackupSession   = 'There is no active backup session: the change is not applied.'
    Err_BackupFailed      = 'The backup could not be created ({0}). For safety, no changes were applied.'
    Err_BackupUnreadable  = 'Could not read backup {0}.'
    Err_ServiceNotAllowed = 'Service {0} is not in the allowed list.'
    Err_ProtectedItem     = '{0} is protected and is not modified.'
    Err_UnknownEntry      = 'Unknown backup entry type: {0}'
    Err_ExitCode          = '{0} finished with exit code {1}.'

    # --- Navigation (v1.1) ----------------------------------------------------
    Menu_8              = 'Change device type'
    Menu_Header         = 'Language: {0}   |   Device: {1}'
    Prompt_BackToMenu   = 'Press Enter or 0 to go back to the menu'
    Preview_ChooseLevel = '=== Preview: choose a level ==='
    Info_ListCancelled  = 'List cancelled: nothing from this list will be applied.'
    Ask_ContinueLevel   = 'Continue with the rest of the level? (N or 0 = back to the menu; nothing has been changed yet)'

    # --- Device type (v1.1) ---------------------------------------------------
    Device_Title             = '=== Device type ==='
    Device_Desktop           = 'Desktop computer'
    Device_Notebook          = 'Notebook / laptop'
    Device_BackToLanguage    = 'Back (to choose language)'
    Device_DetectedBattery   = 'Battery detected: this looks like a notebook.'
    Device_DetectedNoBattery = 'No battery detected: this looks like a desktop computer.'
    Device_MismatchDesktop   = 'Note: a battery was detected, but you chose desktop. You can continue anyway or change it later with option 8.'
    Device_MismatchNotebook  = 'Note: no battery was detected, but you chose notebook. You can continue anyway or change it later with option 8.'
    Device_Selected          = 'Device type: {0}'
    Info_DeviceProfile       = 'Device type: {0} (defines the power plan that is used).'
    Info_NotebookPower       = 'On notebooks the Balanced plan is kept and Ultimate Performance is not offered.'
    Detail_NotebookBalanced  = 'Notebook: the Balanced plan is used (High performance is not forced).'
    Ultimate_NotebookSkipped = 'not offered on notebooks (more heat and less battery)'
    # --- Notebook on battery (v1.1) -------------------------------------------
    Warn_OnBatteryLongTask      = 'Running on battery: connect the charger and run the level again.'
    Detail_DefragSkippedBattery = 'Drive {0}: HDD -> defragmentation skipped (running on battery). Connect the charger and run the level again.'
    Warn_OnBatteryLevel         = 'The notebook is running on battery: DISM and HDD defragmentation will be skipped (SSD TRIM still runs).'}
